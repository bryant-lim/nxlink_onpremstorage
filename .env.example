# CallVault by ESIGO - Environment Variables
# Copy this file to .env and fill in the values

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL="mysql://callvault_user:callvault_password@localhost:3306/callvault"

# ==========================================
# Server Configuration
# ==========================================
PORT=3009
FRONTEND_URL="http://localhost:3008"

# ==========================================
# JWT Authentication
# ==========================================
# IMPORTANT: Generate a strong random secret for production
# Use: openssl rand -hex 32
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==========================================
# Storage Configuration
# ==========================================
RECORDINGS_PATH="./recordings"

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL="info"
LOG_STDOUT_ENABLED=true
LOG_STDERR_ENABLED=true
LOG_CONSOLE_ENABLED=true

# ==========================================
# Docker Compose Variables (for production)
# ==========================================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=callvault
MYSQL_USER=callvault_user
MYSQL_PASSWORD=callvault_password
NEXT_PUBLIC_API_URL=http://localhost:3009/api
