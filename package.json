{
  "name": "nxlink-vr",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @nxlink-vr/server dev\" \"pnpm --filter @nxlink-vr/web dev\"",
    "build": "pnpm --filter @nxlink-vr/server build && pnpm --filter @nxlink-vr/web build",
    "lint": "pnpm --filter \"*\" lint",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\"",
    "db:migrate": "pnpm --filter @nxlink-vr/server db:migrate",
    "db:generate": "pnpm --filter @nxlink-vr/server db:generate",
    "db:seed": "pnpm --filter @nxlink-vr/server db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}
